.grok-bot-mark__eye { fill: var(--bg); transition: fill 0.6s; }

@layer base.grok-bot {
  :where(.grok-bot) { aspect-ratio: 1 / 1; width: 100%; line-height: 0; display: inline-block; position: relative; }
}

.grok-bot__placeholder { height: 100%; position: absolute; inset: 0px; }

.grok-bot-gaze-mark { flex-shrink: 0; display: inline-flex; position: relative; }

.grok-bot-gaze-mark__poses { pointer-events: none; position: absolute; inset: 0px; }

.grok-bot-lazy { line-height: 0; display: inline-block; }

.grok-bot-mark--fill { flex-shrink: 0; width: 100%; }
